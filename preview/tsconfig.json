{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "../mobile/src/*"
      ],
      "react-native": [
        "../mobile/node_modules/react-native"
      ],
      "react": [
        "./node_modules/@types/react"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}