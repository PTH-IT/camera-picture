# Cấu hình backend. Chép thành `.env` rồi điền giá trị thật.
#
# `.env` bị .gitignore chặn — KHÔNG commit file đã điền.
#
# Nguyên tắc của backend: thiếu cấu hình thì TẮT tính năng và cảnh báo rõ, không
# sập lúc khởi động. Endpoint của tính năng bị tắt trả 501 kèm mã `not_configured`
# nên client ẩn nút thay vì báo lỗi. Vì vậy file này có thể để trống gần hết mà
# server vẫn chạy — chỉ là chạy với ít tính năng hơn.

# ---------------------------------------------------------------------------
# Cơ bản
# ---------------------------------------------------------------------------

API_ADDR=:8080

# Postgres. THIẾU BIẾN NÀY thì server chạy bằng store trong bộ nhớ và MẤT SẠCH
# DỮ LIỆU khi tắt tiến trình. Chấp nhận được khi thử nhanh, không bao giờ chấp
# nhận được ở nơi có dữ liệu thật.
#
# Cổng 5433 khớp docker-compose.yml (5432 thường đã bị một Postgres khác chiếm).
DATABASE_URL=postgres://camera:camera@127.0.0.1:5433/camera?sslmode=disable

# ---------------------------------------------------------------------------
# Khoá mã hoá
# ---------------------------------------------------------------------------

# Khoá AES-256 dạng base64, đúng 32 byte. Sinh bằng:
#   openssl rand -base64 32
#
# CẢNH BÁO QUAN TRỌNG: khoá này mã hoá refresh token của Google Drive. ĐỔI KHOÁ
# nghĩa là mọi token đã lưu không giải mã được nữa, và toàn bộ người dùng đã liên
# kết Drive phải liên kết lại — họ sẽ không hiểu vì sao. Khi chuyển sang máy khác
# mà muốn giữ dữ liệu cũ, PHẢI mang theo đúng khoá này.
#
# Sinh khoá tạm mỗi lần khởi động là sai: dữ liệu cũ thành rác sau lần restart
# đầu tiên. Server từ chối chạy thay vì tự sinh, chính vì lý do đó.
STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Đăng nhập xã hội
# ---------------------------------------------------------------------------

# Client ID để xác minh ID token. Nhiều giá trị phân tách bằng dấu phẩy, vì iOS,
# Android và web thường được cấp riêng.
#
# Nhắc lại ràng buộc App Store: có đăng nhập Google thì Sign in with Apple là BẮT
# BUỘC theo guideline 4.8, không phải tuỳ chọn. Xem docs/adr/0002-auth-and-storage.md.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# Lưu trữ do máy chủ quản lý (MinIO / S3)
# ---------------------------------------------------------------------------

# Thiếu MINIO_ENDPOINT thì provider `managed` bị tắt và người dùng chỉ còn lựa
# chọn `device` hoặc Drive của họ.
#
# Server TỪ CHỐI CHẠY nếu có MINIO_ENDPOINT mà thiếu DATABASE_URL: không theo dõi
# được dung lượng đã dùng thì hạn mức là vô nghĩa.
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=devkey
MINIO_SECRET_KEY=devsecret123
MINIO_BUCKET=camera
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# Google Drive của người dùng
# ---------------------------------------------------------------------------

# Server TỪ CHỐI CHẠY nếu có GOOGLE_DRIVE_CLIENT_ID mà thiếu STORAGE_SECRET_KEY:
# chạy tiếp nghĩa là refresh token nằm dạng thô trong cơ sở dữ liệu, và token đó
# cho quyền đọc ghi Drive của người dùng gần như vô thời hạn.
#
# Scope dùng là drive.file và đó là RÀNG BUỘC CỨNG — scope rộng hơn kéo theo kiểm
# định CASA tốn tiền, phải làm lại mỗi 12 tháng. Xem ADR 0002.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_FOLDER=Camera Picture

# ---------------------------------------------------------------------------
# Mua dung lượng qua App Store
# ---------------------------------------------------------------------------

# Thiếu APPLE_ROOT_CERT_FILE thì MỌI hoá đơn đều bị từ chối. Đó là mặc định an
# toàn có chủ ý: bản chấp nhận tất cả sẽ cho bất kỳ ai tự cấp dung lượng không
# giới hạn, và lỗi đó không có triệu chứng nào ngoài hoá đơn hạ tầng tăng vọt.
#
# Tải Apple Root CA - G3 từ https://www.apple.com/certificateauthority/ rồi trỏ
# vào file. KHÔNG tải lúc chạy: ai kiểm soát được đường mạng sẽ thay được gốc tin
# cậy, và khi ấy toàn bộ lớp xác minh chữ ký trở nên vô nghĩa.
APPLE_ROOT_CERT_FILE=
APPLE_BUNDLE_ID=
# "Production" hoặc "Sandbox". Mặc định Production nếu để trống — giao dịch
# Sandbox miễn phí và ai có tài khoản nhà phát triển cũng tạo được.
APPLE_ENVIRONMENT=Production
